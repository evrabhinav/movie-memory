# Postgres connection string, e.g. postgresql://USER:PASSWORD@localhost:5432/movie_memory
DATABASE_URL=

# Auth.js: generate with `npx auth secret` (or `openssl rand -base64 32`)
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OpenAI API key (server-side only; never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=

# Only for `npm start` / self-hosting (dev mode trusts localhost automatically).
# Keep it commented out otherwise: an empty value would disable that dev-mode default.
# AUTH_TRUST_HOST=true
